1 VERSIONINFO
 FILEVERSION    @SADA_VERSION_MAJOR@,@SADA_VERSION_MINOR@,@SADA_VERSION_PATCH@,0
 PRODUCTVERSION @SADA_VERSION_MAJOR@,@SADA_VERSION_MINOR@,@SADA_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sada contributors"
            VALUE "FileDescription",  "@MUSE_APP_TITLE_VERSION@"
            VALUE "FileVersion",      "@SADA_VERSION@"
            VALUE "InternalName",     "@MUSE_APP_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sada contributors. Based on Audacity, Copyright (C) 1999-2026 Audacity Team and others. Published under the GNU General Public License version 3."
            VALUE "OriginalFilename", "@MUSE_APP_NAME@.exe"
            VALUE "ProductName",      "@MUSE_APP_TITLE_VERSION@"
            VALUE "ProductVersion",   "@SADA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
